{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MTLP",
  "version": "0.1.0",
  "identifier": "com.mtlp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MTLP",
        "width": 1280,
        "height": 800,
        "maximized": true,
        "minWidth": 1180,
        "minHeight": 680
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": ["icons/icon.png", "icons/icon.icns"]
  }
}
